#!/system/bin/sh
# ******************************************************
# Description: AegisRoot Universal SukiSU / KSUN Installer
# Base Script Credit: OrangeFox Team, @invisibazinga, @Khargosxh18
# Modified & Maintained By: @Raju_D_yeager
# ******************************************************

MOD_DATE="20261107"
TARGET="SukiSU-Ultra"
SCREEN=/proc/self/fd/$2
ZIPFILE="$3"

FNAME=""
PART=""
KSUD_BIN=""
MAGISKBOOT_BIN=""
SUPPORTED_KERNEL=""

BOOTMODE=false
ps | grep zygote | grep -v grep >/dev/null && BOOTMODE=true
$BOOTMODE || ps -A 2>/dev/null | grep zygote | grep -v grep >/dev/null && BOOTMODE=true

$BOOTMODE && TMP_DIR=/dev/tmp || TMP_DIR=/tmp
mkdir -p "$TMP_DIR"
EX_DIR="$TMP_DIR/twrp_ksu_installer"

ui_print() {
    if [ "$BOOTMODE" = "true" ]; then
        echo "$1"
    else
        until [ -z "$1" ]; do
            echo -e "ui_print $1\nui_print" >> "$SCREEN"
            shift
        done
    fi
}

cleanup() {
    rm -rf "$EX_DIR"
}

abort() {
    ui_print "==========================================="
    ui_print "! ERROR: $*"
    ui_print "==========================================="
    cleanup
    exit 1
}

get_target() {
    if echo "$ZIPFILE" | grep -qi "Next"; then
        TARGET="KernelSU-Next"
    else
        TARGET="SukiSU-Ultra"
    fi
}

Unzip_Installer_Package() {
    mkdir -p "$TMP_DIR"
    cd "$TMP_DIR" || abort "Failed to access temp dir"
    rm -rf "$EX_DIR"
    mkdir -p "$EX_DIR"
    cd "$EX_DIR" || abort "Failed to access extract dir"
    unzip -o "$ZIPFILE" >/dev/null 2>&1 || abort "Failed to extract installer zip"
    chmod -R 0755 "$EX_DIR" 2>/dev/null
}

setup_magiskboot() {
    ui_print "- Setting up magiskboot..."
    if [ -f /system/bin/magiskboot ] && [ -x /system/bin/magiskboot ]; then
        MAGISKBOOT_BIN="/system/bin/magiskboot"
        export PATH="/system/bin:$PATH"
        return
    fi

    if [ -f "$EX_DIR/magiskboot" ]; then
        cp -f "$EX_DIR/magiskboot" /sbin/magiskboot 2>/dev/null
        chmod 0755 /sbin/magiskboot 2>/dev/null
        if [ -f /sbin/magiskboot ] && [ -x /sbin/magiskboot ]; then
            MAGISKBOOT_BIN="/sbin/magiskboot"
            export PATH="/sbin:$PATH"
        else
            cp -f "$EX_DIR/magiskboot" "$TMP_DIR/magiskboot"
            chmod 0755 "$TMP_DIR/magiskboot"
            export PATH="$TMP_DIR:$EX_DIR:$PATH"
            MAGISKBOOT_BIN="$TMP_DIR/magiskboot"
        fi
    else
        abort "magiskboot not found in ZIP!"
    fi
}

find_ksud() {
    local p
    for p in "$EX_DIR/ksud" /sbin/ksud /tmp/ksud /system/bin/ksud; do
        if [ -f "$p" ]; then
            chmod 0755 "$p" 2>/dev/null
            cp -f "$p" /sbin/ksud 2>/dev/null
            chmod 0755 /sbin/ksud 2>/dev/null
            echo "$p"
            return 0
        fi
    done
    return 1
}

find_kernel_kmi() {
    local k_kmi
    local kernel_ver
    local kernel_ver_num

    if [ -n "$KSUD_BIN" ]; then
        k_kmi=$("$KSUD_BIN" boot-info current-kmi 2>/dev/null)
        if [ "$?" = "0" ] && [ -n "$k_kmi" ] && [ "$k_kmi" != "unknown" ]; then
            echo "$k_kmi"
            return
        fi
    fi

    kernel_ver=$(uname -r 2>/dev/null)
    kernel_ver_num=$(echo "$kernel_ver" | cut -d. -f1-2)

    case "$kernel_ver_num" in
        5.*|4.*|3.*) echo "unsupported_legacy" ; return ;;
        6.1)  echo "android14-6.1"  ; return ;;
        6.6)  echo "android15-6.6"  ; return ;;
        6.12) echo "android16-6.12" ; return ;;
        6.18) echo "android17-6.18" ; return ;;
    esac
    echo "unknown"
}

CheckRequirements() {
    KSUD_BIN=$(find_ksud)
    [ -n "$KSUD_BIN" ] && [ -f "$KSUD_BIN" ] || abort "ksud binary not found!"

    local KERNEL_VERSION=$(uname -r 2>/dev/null)
    SUPPORTED_KERNEL=$(find_kernel_kmi)

    if [ "$SUPPORTED_KERNEL" = "unsupported_legacy" ]; then
        abort "Kernel $KERNEL_VERSION is not supported (requires Kernel 6.1+)."
    fi

    FNAME=$(ls "$EX_DIR"/*"${SUPPORTED_KERNEL}"*.ko 2>/dev/null | head -n 1)
    [ -n "$FNAME" ] && [ -e "$FNAME" ] || abort "Missing LKM for $KERNEL_VERSION ($SUPPORTED_KERNEL)"

    ui_print "- Kernel OK : $KERNEL_VERSION"
    ui_print "- Target KMI: $SUPPORTED_KERNEL"
    ui_print "- Module    : $(basename "$FNAME")"

    if [ -e /dev/block/bootdevice/by-name/init_boot_a ] || \
       [ -e /dev/block/by-name/init_boot_a ] || \
       [ -e /dev/block/mapper/init_boot_a ]; then
        PART="init_boot"
    else
        PART="boot"
    fi
    ui_print "- Partition : $PART"
}

do_install() {
    ui_print "- Patching and flashing $PART with $TARGET..."

    mkdir -p /tmp 2>/dev/null
    export HOME="/tmp"
    export TMPDIR="/tmp"

    HELP_OUT=$("$KSUD_BIN" boot-patch --help 2>&1)
    KMI_ARG=""
    echo "$HELP_OUT" | grep -q -- "--kmi" && KMI_ARG="--kmi $SUPPORTED_KERNEL"

    "$KSUD_BIN" boot-patch --module "$FNAME" $KMI_ARG --flash >&2
    if [ $? -ne 0 ]; then
        ui_print "- Native --flash fallback to block dd..."
        SLOT=$(getprop ro.boot.slot_suffix)
        [ -z "$SLOT" ] && SLOT=$(grep -o 'androidboot.slot_suffix=_[ab]' /proc/cmdline | cut -d= -f2)

        TARGET_BLK=""
        for P in "${PART}${SLOT}" "$PART"; do
            for B in "/dev/block/by-name/$P" "/dev/block/bootdevice/by-name/$P" "/dev/block/mapper/$P"; do
                if [ -e "$B" ]; then TARGET_BLK="$B"; break 2; fi
            done
        done
        [ -n "$TARGET_BLK" ] || abort "Could not locate block device for $PART"

        dd if="$TARGET_BLK" of="$EX_DIR/boot.img" bs=4096 2>/dev/null || abort "Failed to dump $TARGET_BLK"
        "$KSUD_BIN" boot-patch --boot "$EX_DIR/boot.img" --module "$FNAME" $KMI_ARG --out "$EX_DIR" >&2 || abort "ksud boot-patch failed!"

        PATCHED_IMG=$(find "$EX_DIR" -maxdepth 1 -type f -name "*patched*.img" | head -n 1)
        [ -f "$PATCHED_IMG" ] || abort "Patched image not found!"

        dd if="$PATCHED_IMG" of="$TARGET_BLK" bs=4096 2>/dev/null || abort "Failed to write patched image!"
        sync
    fi
    ui_print "- $TARGET ramdisk patch complete!"
}

stage_apk_only() {
    [ -f "$EX_DIR/manager.apk" ] || return 0
    mount /data 2>/dev/null
    if [ ! -d "/data/adb" ]; then
        ui_print "! /data is encrypted; install Manager APK manually after boot."
        return 0
    fi

    ui_print "- Staging $TARGET Spoofed Manager APK..."
    mkdir -p /data/adb/service.d
    chmod 0755 /data/adb/service.d

    cp -f "$EX_DIR/manager.apk" /data/adb/aegis_manager.apk
    chmod 0644 /data/adb/aegis_manager.apk
    if [ -d "/data/media/0/Download" ]; then
        cp -f "$EX_DIR/manager.apk" "/data/media/0/Download/${TARGET}_Spoofed_Manager.apk"
        chmod 0664 "/data/media/0/Download/${TARGET}_Spoofed_Manager.apk"
    fi

    cat << 'SCRIPT' > /data/adb/service.d/99_aegis_apk_install.sh
#!/system/bin/sh
APK="/data/adb/aegis_manager.apk"
[ -f "$APK" ] || { rm -f "$0"; exit 0; }

(
  COUNT=0
  until [ "$(getprop sys.boot_completed)" = "1" ] && [ -d "/sdcard/Android" ]; do
    sleep 3
    COUNT=$((COUNT + 1))
    [ "$COUNT" -ge 60 ] && exit 0
  done
  sleep 5

  SIZE=$(stat -c%s "$APK" 2>/dev/null || wc -c < "$APK")
  for TRY in 1 2 3 4; do
    RES=$(cat "$APK" | cmd package install -r -t -g --user 0 -S "$SIZE" 2>&1)
    if echo "$RES" | grep -qi "Success"; then
      rm -f "$APK" "/data/adb/service.d/99_aegis_apk_install.sh"
      exit 0
    fi
    sleep 5
  done
) </dev/null >/dev/null 2>&1 &
exit 0
SCRIPT
    chmod 0755 /data/adb/service.d/99_aegis_apk_install.sh
}

Main() {
    get_target
    Unzip_Installer_Package

    ui_print "==========================================="
    ui_print " ⚡ AEGIS-ROOT : UNIVERSAL AUTO-PATCHER ⚡ "
    ui_print "    Engine    : $TARGET                    "
    ui_print "    Maintainer: @Raju_D_yeager             "
    ui_print "    Version   : $MOD_DATE                  "
    ui_print "==========================================="

    [ "$BOOTMODE" = "true" ] && abort "Flash from custom recovery only!"

    setup_magiskboot
    CheckRequirements
    do_install
    stage_apk_only

    ui_print "==========================================="
    ui_print " ✅ Flashed Successfully! By @Raju_D_yeager"
    ui_print "==========================================="
    cleanup
    exit 0
}

Main
