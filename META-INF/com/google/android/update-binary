#!/sbin/sh
OUTFD=$2
ZIPFILE=$3
TMPDIR=/dev/tmp/aegis_root_install

ui_print() {
  echo "ui_print $1" >&$OUTFD
  echo "ui_print" >&$OUTFD
}

abort() {
  ui_print "========================================"
  ui_print "! FATAL: $1"
  ui_print "========================================"
  rm -rf "$TMPDIR"
  exit 1
}

rm -rf "$TMPDIR"
mkdir -p "$TMPDIR"
cd "$TMPDIR" || abort "Unable to create temp directory"

unzip -o "$ZIPFILE" -d "$TMPDIR" >&2
chmod -R 755 "$TMPDIR"
export PATH="$TMPDIR:$PATH"
export HOME="$TMPDIR"
. "$TMPDIR/config.env"

VARIANT="${ROOT_VARIANT:-SukiSU-Ultra}"

ui_print "========================================"
ui_print " ⚡ AEGIS-ROOT : UNIVERSAL AUTO-PATCHER "
ui_print "    Engine    : $VARIANT + SuSFS LKM    "
ui_print "    Scope     : Universal GKI 2.0+      "
ui_print "    Maintainer: @Raju_D_yeager          "
ui_print "========================================"

# 1. Universal Kernel / KMI Detection (Works on Custom & Stock Kernels)
KERNEL_VER=$(uname -r)
KMI=$(echo "$KERNEL_VER" | sed -nE 's/^([0-9]+\.[0-9]+).*-(android[0-9]+).*/\2-\1/p')
if [ -z "$KMI" ]; then
  KVER=$(echo "$KERNEL_VER" | cut -d. -f1,2)
  case "$KVER" in
    5.10) KMI="android12-5.10" ;;
    5.15) KMI="android13-5.15" ;;
    6.1)  KMI="android14-6.1"  ;;
    6.6)  KMI="android15-6.6"  ;;
    6.12) KMI="android16-6.12" ;;
    6.18) KMI="android17-6.18" ;;
    *) abort "Unsupported kernel version: $KERNEL_VER" ;;
  esac
fi

ui_print "- Kernel   : $KERNEL_VER"
ui_print "- Target   : $KMI"

LKM_FILE="$TMPDIR/${KMI}_kernelsu.ko"
[ -f "$LKM_FILE" ] || abort "Missing LKM for $KMI (${KMI}_kernelsu.ko)"

# 2. Universal Slot & Boot Partition Detection (Fast by-name lookup first)
SLOT=$(getprop ro.boot.slot_suffix)
[ -z "$SLOT" ] && SLOT=$(grep -o 'androidboot.slot_suffix=_[ab]' /proc/cmdline | cut -d= -f2)

TARGET_PART=""
for PART in "init_boot${SLOT}" "init_boot" "boot${SLOT}" "boot"; do
  for BYNAME in "/dev/block/by-name/$PART" "/dev/block/bootdevice/by-name/$PART"; do
    if [ -e "$BYNAME" ]; then
      TARGET_PART="$BYNAME"
      PART_NAME="$PART"
      break 2
    fi
  done
  BLK=$(find /dev/block -name "$PART" 2>/dev/null | head -n 1)
  if [ -n "$BLK" ]; then
    TARGET_PART="$BLK"
    PART_NAME="$PART"
    break
  fi
done

[ -n "$TARGET_PART" ] || abort "Could not locate init_boot or boot block device!"
ui_print "- Partition: $PART_NAME ($TARGET_PART)"

# 3. Dump and Patch Boot/Init_Boot Image via ksud (Dynamic CLI Flag Detection)
ui_print "- Dumping $PART_NAME..."
dd if="$TARGET_PART" of="$TMPDIR/boot.img" bs=4096 2>/dev/null || abort "Failed to dump $PART_NAME"

HELP_TEXT=$("$TMPDIR/ksud" boot-patch --help 2>&1)
set -- boot-patch --boot "$TMPDIR/boot.img" --module "$LKM_FILE"

if echo "$HELP_TEXT" | grep -q -- "--kmi"; then
  set -- "$@" --kmi "$KMI"
fi
if echo "$HELP_TEXT" | grep -q -- "--magiskboot" && [ -f "$TMPDIR/magiskboot" ]; then
  set -- "$@" --magiskboot "$TMPDIR/magiskboot"
fi
if echo "$HELP_TEXT" | grep -q -- "--out"; then
  set -- "$@" --out "$TMPDIR"
fi

ui_print "- Patching ramdisk with $VARIANT LKM..."
ui_print "  Exec: ksud $*"
"$TMPDIR/ksud" "$@" >&2 || abort "ksud boot-patch failed!"

PATCHED_IMG=$(ls -t "$TMPDIR"/kernelsu_patched_*.img "$TMPDIR"/sukisu_patched_*.img "$TMPDIR"/new-boot.img 2>/dev/null | head -n 1)
[ -f "$PATCHED_IMG" ] || abort "Patched image not found in $TMPDIR!"

ui_print "- Flashing patched image to $PART_NAME..."
dd if="$PATCHED_IMG" of="$TARGET_PART" bs=4096 2>/dev/null || abort "Failed to write patched image!"
sync

# 4. Stage Daemon, Detached APK Auto-Installer, SuSFS LKM & Stealth Flags
ui_print "- Mounting /data to stage stealth modules..."
mount /data 2>/dev/null
if [ -d "/data/adb" ]; then
  mkdir -p /data/adb/ksu/bin /data/adb/post-fs-data.d /data/adb/service.d /data/adb/boot-completed.d /data/adb/susfs4ksu

  cp -f "$TMPDIR/ksud" /data/adb/ksud
  cp -f "$TMPDIR/ksud" /data/adb/ksu/bin/ksud
  chmod 755 /data/adb/ksud /data/adb/ksu/bin/ksud
  chcon u:object_r:system_file:s0 /data/adb/ksud /data/adb/ksu/bin/ksud 2>/dev/null

  if [ -f "$TMPDIR/manager.apk" ]; then
    ui_print "- Staging $VARIANT Spoofed Manager APK..."
    cp -f "$TMPDIR/manager.apk" /data/adb/ksu/manager.apk
    chmod 644 /data/adb/ksu/manager.apk
    if [ -d "/data/media/0/Download" ]; then
      cp -f "$TMPDIR/manager.apk" "/data/media/0/Download/${VARIANT}_Spoofed_Manager.apk"
      chmod 664 "/data/media/0/Download/${VARIANT}_Spoofed_Manager.apk"
    fi

    rm -f /data/adb/service.d/99_izanami_manager_install.sh /data/adb/service.d/99_aegis_manager_install.sh

    cat << 'SCRIPT' > /data/adb/ksu/apk_worker.sh
#!/system/bin/sh
LOG="/data/adb/ksu/apk_install.log"
APK="/data/adb/ksu/manager.apk"
echo "[$(date)] AegisRoot detached APK worker started (PID $$)" > "$LOG"

# Wait up to 3 minutes for boot_completed AND FBE credential unlock (/sdcard/Android readable)
COUNT=0
until [ "$(getprop sys.boot_completed)" = "1" ] && [ -d "/sdcard/Android" ]; do
  sleep 3
  COUNT=$((COUNT + 1))
  [ "$COUNT" -ge 60 ] && break
done
sleep 6

if [ ! -f "$APK" ]; then
  echo "APK already installed or missing at $APK" >> "$LOG"
  exit 0
fi

# Disable HyperOS / MIUI / Play Protect ADB installation blocks temporarily
settings put global verifier_verify_adb_installs 0 2>/dev/null
settings put global package_verifier_enable 0 2>/dev/null
settings put secure install_non_market_apps 1 2>/dev/null

TMP_APK="/data/local/tmp/aegis_mgr.apk"
cp -f "$APK" "$TMP_APK"
chown 2000:2000 "$TMP_APK" 2>/dev/null
chmod 644 "$TMP_APK"
chcon u:object_r:shell_data_file:s0 "$TMP_APK" 2>/dev/null || chcon u:object_r:apk_data_file:s0 "$TMP_APK" 2>/dev/null

SIZE=$(stat -c%s "$TMP_APK" 2>/dev/null || wc -c < "$TMP_APK")
INSTALLED=0

for TRY in 1 2 3 4 5 6 7 8; do
  echo "--- Attempt $TRY (size=$SIZE) ---" >> "$LOG"

  # Method 1: One-shot stdin stream via cmd package install -S
  RES1=$(cat "$TMP_APK" | cmd package install -r -t -g -i com.android.vending --user 0 -S "$SIZE" 2>&1)
  echo "Method 1 (stream -S): $RES1" >> "$LOG"
  if echo "$RES1" | grep -qi "Success"; then INSTALLED=1; break; fi

  # Method 2: Explicit session create + write with '-' stdin marker + commit
  SID=$(cmd package install-create -r -t -g --user 0 2>/dev/null | sed -nE 's/.*\[([0-9]+)\].*/\1/p' | head -n 1)
  if [ -n "$SID" ]; then
    WRES=$(cat "$TMP_APK" | cmd package install-write -S "$SIZE" "$SID" base.apk - 2>&1)
    CRES=$(cmd package install-commit "$SID" 2>&1)
    echo "Method 2 (session $SID): write=$WRES | commit=$CRES" >> "$LOG"
    if echo "$CRES" | grep -qi "Success"; then INSTALLED=1; break; fi
  fi

  # Method 3: Direct path install as root and as shell (UID 2000)
  RES3=$(pm install -r -t -g --user 0 "$TMP_APK" 2>&1)
  echo "Method 3 (direct root): $RES3" >> "$LOG"
  if echo "$RES3" | grep -qi "Success"; then INSTALLED=1; break; fi

  RES4=$(su -lp 2000 -c "pm install -r --user 0 $TMP_APK" 2>&1)
  echo "Method 4 (shell uid 2000): $RES4" >> "$LOG"
  if echo "$RES4" | grep -qi "Success"; then INSTALLED=1; break; fi

  sleep 6
done

rm -f "$TMP_APK"

if [ "$INSTALLED" = "1" ]; then
  echo "[SUCCESS] Manager APK installed cleanly!" >> "$LOG"
  rm -f "$APK" \
        /data/adb/boot-completed.d/99_aegis_manager_install.sh \
        /data/adb/service.d/99_aegis_manager_install.sh \
        /data/adb/ksu/apk_worker.sh
else
  echo "[WARN] Auto-install did not return Success yet; keeping worker for next boot. Fallback APK in /sdcard/Download/" >> "$LOG"
fi
SCRIPT
    chmod 755 /data/adb/ksu/apk_worker.sh

    # Launcher stub that detaches via setsid & closes FDs immediately so ksud timeout never kills it
    cat << 'LAUNCHER' > /data/adb/boot-completed.d/99_aegis_manager_install.sh
#!/system/bin/sh
if [ -f /data/adb/ksu/apk_worker.sh ]; then
  if command -v setsid >/dev/null 2>&1; then
    setsid /system/bin/sh /data/adb/ksu/apk_worker.sh </dev/null >/dev/null 2>&1 &
  else
    nohup /system/bin/sh /data/adb/ksu/apk_worker.sh </dev/null >/dev/null 2>&1 &
  fi
fi
exit 0
LAUNCHER
    chmod 755 /data/adb/boot-completed.d/99_aegis_manager_install.sh
    cp -f /data/adb/boot-completed.d/99_aegis_manager_install.sh /data/adb/service.d/99_aegis_manager_install.sh
    chmod 755 /data/adb/service.d/99_aegis_manager_install.sh
  fi

  if [ "$ENABLE_SUSFS_LKM" = "1" ] && [ -f "$TMPDIR/susfs_guard_lkm-${KMI}.ko" ]; then
    ui_print "- Staging SuSFS LKM ($KMI)..."
    cp -f "$TMPDIR/susfs_guard_lkm-${KMI}.ko" /data/adb/susfs4ksu/susfs_guard_lkm.ko
    chmod 644 /data/adb/susfs4ksu/susfs_guard_lkm.ko
  fi

  cat << 'SCRIPT' > /data/adb/post-fs-data.d/00_sukisu_stealth.sh
#!/system/bin/sh
MODDIR=/data/adb/susfs4ksu
if [ -f "$MODDIR/susfs_guard_lkm.ko" ] && [ ! -e "/proc/susfs_version" ]; then
  /data/adb/ksud insmod "$MODDIR/susfs_guard_lkm.ko" expose_proc=1 2>/dev/null || insmod "$MODDIR/susfs_guard_lkm.ko" expose_proc=1 2>/dev/null
fi
SCRIPT

  if [ "$ENABLE_AVC_SPOOF" = "1" ]; then
    ui_print "- Configuring AVC Log Spoofing: ENABLED"
    cat << 'SCRIPT' >> /data/adb/post-fs-data.d/00_sukisu_stealth.sh
/data/adb/ksud feature set avc_spoof 1 2>/dev/null || echo 1 > /sys/module/kernelsu/parameters/enable_avc_spoof 2>/dev/null
touch /data/adb/ksu/.avc_spoof_enabled
SCRIPT
  fi

  if [ "$ENABLE_HIDE_SELINUX" = "1" ]; then
    ui_print "- Configuring Hide SELinux Mod: ENABLED"
    cat << 'SCRIPT' >> /data/adb/post-fs-data.d/00_sukisu_stealth.sh
/data/adb/ksud feature set hide_selinux 1 2>/dev/null || echo 1 > /sys/module/kernelsu/parameters/hide_selinux 2>/dev/null
touch /data/adb/ksu/.hide_selinux_enabled
SCRIPT
  fi

  cat << 'SCRIPT' >> /data/adb/post-fs-data.d/00_sukisu_stealth.sh
/data/adb/ksud feature save 2>/dev/null
SCRIPT
  chmod 755 /data/adb/post-fs-data.d/00_sukisu_stealth.sh
else
  ui_print "! /data is encrypted/unmounted; boot patch succeeded, install Manager APK after boot."
fi

ui_print "- Cleaning up temporary files..."
rm -rf "$TMPDIR"
ui_print "========================================"
ui_print " ✅ Flashed Successfully! By @Raju_D_yeager"
ui_print "========================================"
exit 0
